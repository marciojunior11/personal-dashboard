// Identity: users, the organizations they belong to, and their memberships.
// These are table shapes only; the domain entities live in src/domain.

enum OrganizationType {
  INDIVIDUAL
  BUSINESS
}

enum OrganizationMemberRole {
  OWNER
  PROFESSIONAL
}

model User {
  id           String   @id @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(150)
  birthDate    DateTime @map("birth_date") @db.Date
  /// Unique, so two accounts never share an e-mail, even under concurrent sign-ups.
  email        String?  @unique @db.VarChar(254)
  /// 11 digits; unique for the same reason as the e-mail.
  phone        String?  @unique @db.VarChar(11)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships OrganizationMember[]
  sessions    Session[]

  @@map("users")
}

model Session {
  id                String   @id @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the token sent in the cookie; the token itself is never stored.
  tokenHash         String   @unique @map("token_hash") @db.Char(64)
  /// Only shown in the list of the user's devices; never trusted for security.
  userAgent         String?  @map("user_agent") @db.VarChar(512)
  ip                String?  @db.Inet
  createdAt         DateTime @default(now()) @map("created_at")
  lastSeenAt        DateTime @map("last_seen_at")
  /// When the session ends: the idle deadline, capped at the absolute one.
  expiresAt         DateTime @map("expires_at")
  /// The hard limit; no activity extends a session past it.
  absoluteExpiresAt DateTime @map("absolute_expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Lists and revokes every session of a user.
  @@index([userId])
  /// Lets a cleanup job delete the expired sessions.
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id        String           @id @db.Uuid
  name      String           @db.VarChar(150)
  type      OrganizationType
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  members      OrganizationMember[]
  subscription Subscription?

  @@map("organizations")
}

model OrganizationMember {
  id             String                 @id @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  role           OrganizationMemberRole
  createdAt      DateTime               @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// A user joins each organization at most once.
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}
