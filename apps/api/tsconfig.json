{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    // Each alias points at a folder's barrel (index.ts), so only whole
    // namespaces can be imported: never a file inside them, never a layer.
    "paths": {
      "@application/*": ["./src/application/*/index.ts"],
      "@domain/*": ["./src/domain/*/index.ts"],
      "@infrastructure/*": ["./src/infrastructure/*/index.ts"],
      "@presentation/*": ["./src/presentation/*/index.ts"],
      "@common": ["./src/common/index.ts"]
    }
  }
}
